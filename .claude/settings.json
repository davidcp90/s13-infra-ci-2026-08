{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/backups/**)",
      "Edit(**/backups/**)",
      "Bash(*backups*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Revisando que no salgan datos personales ni secretos...",
            "timeout": 30,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/datos-que-no-salen.sh"
          },
          {
            "type": "command",
            "statusMessage": "Comprobando que la orden no borre datos...",
            "timeout": 30,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sin-borrar-datos.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Formateando frontend con Prettier...",
            "timeout": 30,
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/frontend/*) cd \"$CLAUDE_PROJECT_DIR/frontend\" && ./node_modules/.bin/prettier --write --ignore-unknown \"$f\";; esac; } 2>/dev/null || true"
          },
          {
            "type": "command",
            "statusMessage": "Comprobando que no haya colores a pelo en el frontend...",
            "timeout": 30,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/color-con-nombre.sh"
          },
          {
            "type": "command",
            "statusMessage": "Validando los workflows con actionlint...",
            "timeout": 120,
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-valido.sh"
          }
        ]
      }
    ]
  }
}
